<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PubKEYS — Пульт управления" Width="1240" Height="900" MinWidth="1020" MinHeight="720" WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI" FontSize="13" Background="#F2F6F7" Foreground="#20383E" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Teal" Color="#137D82"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#687F85"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,13"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#536F76"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="BorderBrush" Value="#CBDBDF"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="33"/><Setter Property="SelectionBrush" Value="#137D82"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="33"/><Setter Property="BorderBrush" Value="#CBDBDF"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="#25464D"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C5D7DB"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#D8EBEC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#137D82"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#137D82"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Mode" TargetType="RadioButton"><Setter Property="Padding" Value="11,11"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse x:Name="dot" Width="10" Height="10" Fill="#D3E0E3" VerticalAlignment="Top" Margin="0,5,8,0"/><ContentPresenter Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="bg" Property="Background" Value="#E4F2F1"/><Setter TargetName="bg" Property="BorderBrush" Value="#B6DAD8"/><Setter TargetName="dot" Property="Fill" Value="#137D82"/><Setter Property="Foreground" Value="#106A70"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="#B6DAD8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DAE5E8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/></Style>
  <Style x:Key="Sample" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="True"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Background" Value="#F6F9FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="MinHeight" Value="32"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="79"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#D9E5E7" BorderThickness="0,0,0,1" Padding="24,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="PubKEYS" FontSize="25" FontWeight="SemiBold" Foreground="#126C73"/><TextBlock x:Name="HeaderGpuTemperature" Text="GPU —" FontSize="16" FontWeight="SemiBold" Foreground="#397D82" VerticalAlignment="Center" Margin="14,3,0,0" ToolTip="Температура GPU · ожидание датчика"/></StackPanel><TextBlock Text="ПУЛЬТ УПРАВЛЕНИЯ" FontSize="10" Foreground="#71888E" FontWeight="SemiBold" Margin="1,1,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#ECF4F4" CornerRadius="12" Padding="12,6" Margin="0,0,15,0"><TextBlock x:Name="StateLabel" Text="Готов к запуску" Foreground="#397177" FontSize="12"/></Border>
     <TextBlock x:Name="SessionElapsed" Text="00:00:00" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="#4B6F76" VerticalAlignment="Center" MinWidth="68" MaxWidth="116" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" ToolTip="Длительность текущего сеанса"/>
     <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Запустить" Margin="0,0,7,0"/>
     <Button x:Name="PauseButton" Content="Пауза" IsEnabled="False" Margin="0,0,7,0"/>
     <Button x:Name="StopButton" Content="Завершить" IsEnabled="False"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="20,18,20,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border Style="{StaticResource Card}" Padding="12,18,12,12">
      <StackPanel><TextBlock Text="Режим поиска" Style="{StaticResource Section}" Margin="6,0,0,14"/>
       <RadioButton x:Name="ModeSeq" Tag="seq" GroupName="Mode" Style="{StaticResource Mode}"><StackPanel><TextBlock Text="Детерминированный" FontWeight="SemiBold"/><TextBlock Text="Подряд или по HEX-маске" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></RadioButton>
       <RadioButton x:Name="ModeKxe" Tag="kxe" GroupName="Mode" Style="{StaticResource Mode}"><StackPanel><TextBlock Text="KXE" FontWeight="SemiBold"/><TextBlock Text="Перестановка блоков" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></RadioButton>
       <RadioButton x:Name="ModeRandom" Tag="random" GroupName="Mode" Style="{StaticResource Mode}"><StackPanel><TextBlock Text="Случайный" FontWeight="SemiBold"/><TextBlock Text="Случайная выборка" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></RadioButton>
       <RadioButton x:Name="ModeZone" Tag="zone" GroupName="Mode" Style="{StaticResource Mode}"><StackPanel><TextBlock Text="Зонный" FontWeight="SemiBold"/><TextBlock Text="Окрестности баз" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></RadioButton>
       <RadioButton x:Name="ModeWave" Tag="wave" GroupName="Mode" Style="{StaticResource Mode}"><StackPanel><TextBlock Text="Волновой" FontWeight="SemiBold"/><TextBlock Text="Растущий узор" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></RadioButton>
       <RadioButton x:Name="ModeHybrid" Tag="hybrid" GroupName="Mode" Style="{StaticResource Mode}"><StackPanel><TextBlock Text="Гибридный" FontWeight="SemiBold"/><TextBlock Text="Случайная A · перебор B" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></RadioButton>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,14,0,0">
      <StackPanel><DockPanel><TextBlock Text="Нагрузка GPU" FontWeight="SemiBold"/><TextBlock x:Name="PowerLabel" Text="—" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#137D82" FontWeight="Bold"/></DockPanel>
       <Slider x:Name="PowerSlider" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" Margin="0,16,0,5" TickPlacement="BottomRight"/>
       <DockPanel><TextBlock Text="50%" Style="{StaticResource Muted}"/><TextBlock Text="100%" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
       <TextBlock x:Name="PowerActual" Text="Фактически: —" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
       <TextBlock Text="Доля времени работы GPU. Скорость зависит от режима и карты." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock x:Name="ModeNote" Text="" Style="{StaticResource Muted}" Margin="5,15,5,0"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="0">
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,18,20,12">
       <StackPanel x:Name="SettingsPanel">
        <TextBlock Text="Параметры прохода" Style="{StaticResource Section}"/>
        <TextBlock Text="БИТОВЫЙ ДИАПАЗОН" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="23"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="От 2^" Style="{StaticResource Muted}" Margin="0,0,0,4"/><TextBox x:Name="RangeStart" AutomationProperties.Name="Начальный бит"/></StackPanel>
         <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,9" Foreground="#7B9399"/>
         <StackPanel Grid.Column="2"><TextBlock Text="До 2^ (не включая)" Style="{StaticResource Muted}" Margin="0,0,0,4"/><TextBox x:Name="RangeEnd" AutomationProperties.Name="Конечный бит"/></StackPanel>
        </Grid>
        <TextBlock x:Name="RangeSummary" Style="{StaticResource Muted}" Margin="0,6,0,13"/>
        <StackPanel x:Name="MaskPanel" Visibility="Collapsed">
         <TextBlock Text="ДЕТЕРМИНИРОВАННЫЙ ПЕРЕБОР" Style="{StaticResource Caption}"/>
         <CheckBox x:Name="UseMask" Content="Начать с образца · неизменный HEX-хвост"/>
         <StackPanel x:Name="MaskFields"><TextBlock Text="Образец ключа · ровно 64 знака HEX" Style="{StaticResource Muted}" Margin="0,5,0,5"/>
          <TextBox x:Name="MaskHex" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MinHeight="58" AutomationProperties.Name="Образец 64 HEX"/>
          <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><TextBlock Text="Не меняются младшие нибблы, справа" VerticalAlignment="Center" FontSize="12"/><TextBox x:Name="Freeze" Grid.Column="1" AutomationProperties.Name="Число замороженных младших нибблов"/></Grid>
          <TextBlock x:Name="MaskSummary" Style="{StaticResource Muted}" Margin="0,7,0,12"/>
         </StackPanel>
        </StackPanel>
        <Grid x:Name="NPanel" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="83"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="NLabel" Text="Размер блока N" FontWeight="SemiBold"/><TextBlock x:Name="NHint" Style="{StaticResource Muted}" FontSize="11"/></StackPanel><ComboBox x:Name="BlockN" Grid.Column="1" AutomationProperties.Name="Размер блока N"/></Grid>
        <StackPanel x:Name="WaveStartPanel" Visibility="Collapsed" Margin="0,0,0,13"><TextBlock Text="Начальная точка волны · 64 HEX" Style="{StaticResource Caption}"/><TextBox x:Name="WaveStart" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MinHeight="58" AutomationProperties.Name="Начальная точка волны 64 HEX"/><TextBlock Text="Пусто — случайные базы. Заданный ключ запускает исходный конечный узор один раз." Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
        <Grid x:Name="ChunkPanel" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="83"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Участок 2^N" FontWeight="SemiBold"/><TextBlock Text="Размер участка на поток · N = 10–40" Style="{StaticResource Muted}" FontSize="11"/></StackPanel><TextBox x:Name="ChunkBits" Grid.Column="1" AutomationProperties.Name="Показатель участка"/></Grid>
        <CheckBox x:Name="WantNk"><StackPanel><TextBlock Text="Проверять зеркало n−k"/><TextBlock Text="В том числе совпадения вне диапазона" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></CheckBox>
        <Border Height="1" Background="#E4ECEE" Margin="0,12,0,15"/>
        <StackPanel x:Name="LeadingPanel">
         <TextBlock Text="ВЕДУЩАЯ HEX-ЦИФРА" Style="{StaticResource Caption}"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="LeadingHex" AutomationProperties.Name="Ведущая HEX цифра"/><TextBox x:Name="DigitHours" Grid.Column="2" AutomationProperties.Name="Время смены цифры в часах"/></Grid>
         <TextBlock Text="Справа — часов на цифру; 0 отключает смену. «Все» использует весь диапазон." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,12"/>
        </StackPanel>
        <TextBlock Text="БАЗА ПУБЛИЧНЫХ КЛЮЧЕЙ" Style="{StaticResource Caption}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition Width="39"/></Grid.ColumnDefinitions><TextBox x:Name="PubkeyPath" AutomationProperties.Name="Файл базы публичных ключей"/><Button x:Name="BrowseDb" Grid.Column="2" Content="…" Padding="5" ToolTip="Выбрать файл базы"/></Grid>
        <TextBlock Text="ФАЙЛ РЕЗУЛЬТАТОВ" Style="{StaticResource Caption}" Margin="0,13,0,5"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition Width="39"/></Grid.ColumnDefinitions><TextBox x:Name="FoundPath" AutomationProperties.Name="Файл результатов"/><Button x:Name="BrowseFound" Grid.Column="2" Content="…" Padding="5" ToolTip="Выбрать файл результатов"/></Grid>
        <CheckBox x:Name="DebugChunks" Content="Записывать участки в журнал" Margin="0,12,0,4"/>
        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Потоки CPU" FontWeight="SemiBold"/><TextBlock Text="1–1024 · GPU использует свой backend" Style="{StaticResource Muted}" FontSize="11"/></StackPanel><TextBox x:Name="Threads" Grid.Column="1" AutomationProperties.Name="Число потоков CPU"/></Grid>
        <Border Height="1" Background="#E4ECEE" Margin="0,12,0,15"/>
        <TextBlock Text="УВЕДОМЛЕНИЯ О ПРОГРЕССЕ" Style="{StaticResource Caption}"/>
        <StackPanel Orientation="Horizontal"><CheckBox x:Name="TgProgress" Content="Telegram" Margin="0,5,22,5"/><CheckBox x:Name="SignalProgress" Content="Signal" Margin="0,5,0,5"/></StackPanel>
        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="Скорость · интервал, секунд" VerticalAlignment="Center" FontSize="12"/><TextBox x:Name="ProgressSeconds" Grid.Column="1" AutomationProperties.Name="Интервал уведомления о скорости"/></Grid>
        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><TextBlock Text="Проверка · интервал, секунд" VerticalAlignment="Center" FontSize="12"/><TextBox x:Name="CheckSeconds" Grid.Column="1" AutomationProperties.Name="Интервал уведомления о проверке"/></Grid>
        <TextBlock Text="Используются существующие настройки доставки. Секреты в этом окне не отображаются." Style="{StaticResource Muted}" FontSize="11" Margin="0,9,0,5"/>
       </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="#E1E9EC" BorderThickness="0,1,0,0" Padding="18,12" Background="#F9FBFB" CornerRadius="0,0,10,10">
       <StackPanel><TextBlock x:Name="ValidationMessage" Text="" Foreground="#A35A35" FontSize="12" Margin="0,0,0,7" Visibility="Collapsed"/><Button x:Name="ApplyButton" Content="Применить параметры" HorizontalAlignment="Stretch"/><TextBlock x:Name="ApplyNote" Text="Изменения применятся перед запуском." Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
      </Border>
     </Grid>
    </Border>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="СКОРОСТЬ" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="RateValue" Text="—" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RateUnit" Text="ключей/с" Style="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="RateHint" Text="средняя за 60 с" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="ПРОВЕРЕНО" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="CountValue" Text="—" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CountUnit" Text="ключей" Style="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="CountHint" Text="обновление каждые 60 с" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
      <Border x:Name="FoundCard" Grid.Column="4" Style="{StaticResource Card}" Padding="12" Cursor="Hand" Focusable="True" ToolTip="Новые реальные находки отмечаются красным. Щёлкните, чтобы подтвердить индикатор."><StackPanel><TextBlock Text="НАЙДЕНО" Style="{StaticResource Caption}" FontSize="10"/><TextBlock x:Name="FoundValue" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#137D82"/><TextBlock Text="совпадений" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
     </Grid>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel Margin="18,15,18,10"><TextBlock Text="Полный начальный образец" FontSize="15" FontWeight="SemiBold"/><Border Background="#FFF2DB" CornerRadius="4" Padding="7,5" Margin="0,9,0,0"><TextBlock Text="Пробный образец — НЕ находка" Foreground="#895B1F" FontWeight="SemiBold" FontSize="11"/></Border><TextBlock Text="Фиксируется для текущих применённых параметров." Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
       <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,5"><StackPanel>
        <TextBlock Text="PRIVATE KEY" Style="{StaticResource Caption}"/><TextBox x:Name="InitialPrivate" Style="{StaticResource Sample}" Text="Ожидание начального образца…"/>
        <TextBlock Text="X" Style="{StaticResource Caption}"/><TextBox x:Name="InitialX" Style="{StaticResource Sample}" Text="—"/>
        <TextBlock Text="Y" Style="{StaticResource Caption}"/><TextBox x:Name="InitialY" Style="{StaticResource Sample}" Text="—"/>
        <TextBlock Text="PUBc · COMPRESSED" Style="{StaticResource Caption}"/><TextBox x:Name="InitialPubC" Style="{StaticResource Sample}" Text="—"/>
        <TextBlock Text="PUBu · UNCOMPRESSED" Style="{StaticResource Caption}"/><TextBox x:Name="InitialPubU" Style="{StaticResource Sample}" Text="—"/>
       </StackPanel></ScrollViewer>
      </Grid>
     </Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,13,0,13" Padding="15,12"><StackPanel><DockPanel><TextBlock Text="ТЕКУЩИЙ PRIVATE KEY" Style="{StaticResource Caption}"/><TextBlock x:Name="CurrentStamp" Text="каждые 30 с" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="10"/></DockPanel><TextBox x:Name="CurrentPrivate" Style="{StaticResource Sample}" Text="—" Margin="0"/><TextBlock Text="Текущий образец работы · не означает находку" Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
     <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,11"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><TextBlock Text="Журнал сеанса" FontWeight="SemiBold"/><Button x:Name="OpenJournal" Content="Открыть" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="8,2" MinHeight="24" FontSize="10"/></DockPanel><TextBox x:Name="Journal" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="0,7,0,0"/></Grid></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#D9E5E7" BorderThickness="0,1,0,0" Background="White" Padding="23,9"><DockPanel><TextBlock x:Name="FooterMessage" Text="Параметры загружены. Движок ещё не запущен." Foreground="#658087" FontSize="11"/><TextBlock x:Name="ActualSettings" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="" Foreground="#658087" FontSize="11"/></DockPanel></Border>
 </Grid>
</Window>
